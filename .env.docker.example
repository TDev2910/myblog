# Dùng cho docker-compose.yml trên VPS — copy thành .env cạnh docker-compose.yml
# (KHÔNG commit file .env thật). Khác .env.example (dev local) ở các host trỏ
# vào tên service trong mạng Docker (mysql/redis/ssr) thay vì 127.0.0.1.

APP_NAME=myblog
APP_ENV=production
APP_KEY=                      # điền bằng: docker compose run --rm release php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://myblog.example.com

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=myblog
DB_USERNAME=myblog
DB_PASSWORD=                  # đặt mật khẩu mạnh — biến này cũng được compose dùng để khởi tạo MySQL

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
SCOUT_DRIVER=database

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Trỏ vào service "ssr" trong docker-compose.yml (không phải 127.0.0.1 —
# đây là container khác). Nếu service này chết, Inertia tự fallback sang
# client-side render (xem deploy/README.md).
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://ssr:13714

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@myblog.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Để trống -> ProcessPhoto tự fallback lưu ảnh vào volume storage_public.
# Điền đủ 4 biến này khi muốn chuyển ảnh sang DigitalOcean Spaces (không cần
# sửa code, xem app/Jobs/ProcessPhoto.php::targetDisk()).
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
DO_SPACES_CDN=

VITE_APP_NAME="${APP_NAME}"
